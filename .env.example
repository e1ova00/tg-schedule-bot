# Токен бота от @BotFather
BOT_TOKEN=

# Нужен только если Telegram у вас доступен исключительно через прокси
# (например, тот же адрес, что настроен в Windows для обхода блокировок).
# Формат: socks5://IP:порт или http://IP:порт. Если Telegram открывается
# и без прокси — оставьте пустым.
TELEGRAM_PROXY_URL=

# Ключ 2ГИС Routing API (dev.2gis.ru)
DGIS_API_KEY=

# Запасной маршрутизатор, если 2ГИС не дали ключ (openrouteservice.org)
ORS_API_KEY=

# Какой маршрутизатор использовать: dgis | ors
# Пусто — то же самое, что dgis.
# Если ключ выбранного маршрутизатора не заполнен, бот не падает: он считает время
# в пути очень грубо, по прямой линии, и честно пишет об этом в ответе на /route.
ROUTER=dgis

# Насколько умножать время в пути в часы пик (будни 7:00–10:00 и 17:00–20:00),
# когда маршрут считает OpenRouteService: пробок он не знает, поэтому «утренний час»
# приходится закладывать вручную. 1.4 — это «дорога дольше на 40%».
# Число должно быть больше 1.0. Для 2ГИС не используется: там пробки настоящие.
ORS_PEAK_HOUR_FACTOR=1.4

# Во сколько (по Москве) бот каждое утро пересчитывает будильники на день:
# смотрит, есть ли сегодня очная пара, считает дорогу и ставит подъём на точное время.
# Формат ЧЧ:ММ. Ставьте заведомо раньше самого раннего возможного подъёма — то, что
# уже прошло, бот может только отправить сразу, но не отмотать назад.
ALARM_PLANNING_TIME=05:00

# Сколько минут считать дорогой, если сервис маршрутов не ответил.
# Бот всё равно разбудит — по этой оценке — и честно напишет, что пробки посмотреть
# не удалось. Ставьте своё обычное время в пути до университета.
ALARM_FALLBACK_TRAVEL_MINUTES=60

# Во сколько (по Москве) утром напоминать про незакрытую заметку в день самой пары.
# Первое напоминание приходит за сутки до пары, это — повторное, для тех заметок,
# которые к утру всё ещё не закрыты. Формат ЧЧ:ММ.
# Если до пары остаётся меньше часа, повтор не приходит: напоминание уже было накануне.
NOTES_MORNING_TIME=08:00

# Telegram ID тех, кому разрешён доступ, через запятую.
# Свой ID можно узнать у бота @userinfobot
# Пусто — бот отвечает всем подряд. Заполните, когда закончите настройку:
# тогда остальным он будет вежливо отказывать.
ALLOWED_USER_IDS=

TZ=Europe/Moscow
DB_PATH=data/bot.db
LOG_LEVEL=INFO
