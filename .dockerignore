# Что НЕ надо класть в образ. Смысл двойной: образ меньше, и секреты с базой
# не попадают внутрь картинки, которую можно случайно куда-нибудь выложить.

# Секреты и локальные настройки
.env
.env.*
!.env.example

# Локальное окружение Windows/Linux — внутри контейнера своё.
# ** нужны не для красоты: без них Docker отбросил бы только папки в корне проекта,
# а app/__pycache__ уехал бы в образ.
.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# История git на работу бота не влияет
.git/
.gitignore
.github/

# База и логи приходят с сервера через volume, а не из образа
data/bot.db
data/bot.db-wal
data/bot.db-shm
backups/
logs/
*.log

# Тесты и их кэш в продакшене не нужны — бот их не запускает
tests/
.pytest_cache/
pytest.ini

# Документация и вспомогательные скрипты для сервера
docs/
scripts/
README.md
CLAUDE.md
.claude/
Dockerfile
.dockerignore
docker-compose.yml
